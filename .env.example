# Copy to .env and fill in. Never commit .env.

# Context.dev — context.dev/signup, redeem JUNCTION26 at context.dev/dashboard/redeem-credits
CONTEXT_DEV_API_KEY=
# Requests per minute your Context.dev plan allows. A free organisation gets 10; raise this when the plan does.
CONTEXT_DEV_RPM=10

# OpenAI — platform.openai.com/api-keys.
OPENAI_API_KEY=
# Optional. Default: gpt-6-sol with reasoning off (best lines of the fast models; about 2 s per script).
# With another model, set OPENAI_REASONING_EFFORT only if that model accepts it.
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=

# ElevenLabs — Developers > API Keys.
ELEVENLABS_API_KEY=
# Optional. Default: George (JBFqnCBsd6RMkjVDRZzb), a warm British storyteller. Voices > copy Voice ID to change.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

PORT=8787
DATA_DIR=./data

# Hosting. HOST: the address to listen on (127.0.0.1 behind a reverse proxy on the same machine; 0.0.0.0 in a container).
# TRUST_PROXY: how many reverse proxies stand in front (1 for a single Caddy or nginx; 0 when visitors reach the server directly).
# SITE_DIR: the folder the landing page is served from (default ../site/public, relative to apps/server).
HOST=127.0.0.1
TRUST_PROXY=0
SITE_DIR=

# How many new videos may be built. Each one spends credit at Context.dev, OpenAI and ElevenLabs.
VIDEO_BUILDS_PER_VISITOR_PER_HOUR=120
VIDEO_BUILDS_AT_ONCE=4
VIDEO_BUILDS_PER_DAY=1500

# off | record | replay — replay serves recorded Context.dev responses without network
FIXTURE_MODE=off
