# Copy to .env and fill in. Never commit .env.

# Context.dev — context.dev/signup, redeem JUNCTION26 at context.dev/dashboard/redeem-credits
CONTEXT_DEV_API_KEY=

# OpenAI — platform.openai.com/api-keys. Model: a small, fast one that supports structured outputs.
OPENAI_API_KEY=
OPENAI_MODEL=

# ElevenLabs — Developers > API Keys; Voices > copy Voice ID
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

PORT=8787
DATA_DIR=./data

# off | record | replay — replay serves recorded Context.dev responses without network
FIXTURE_MODE=off
