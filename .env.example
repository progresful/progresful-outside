# Copy to .env and fill in. Never commit .env.

# Context.dev — context.dev/signup, redeem JUNCTION26 at context.dev/dashboard/redeem-credits
CONTEXT_DEV_API_KEY=
# Requests per minute your Context.dev plan allows. A free organisation gets 10; raise this when the plan does.
CONTEXT_DEV_RPM=10

# OpenAI — platform.openai.com/api-keys.
OPENAI_API_KEY=
# Optional. Default: gpt-6-sol with reasoning off (best lines of the fast models; about 2 s per script).
# With another model, set OPENAI_REASONING_EFFORT only if that model accepts it.
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=

# ElevenLabs — Developers > API Keys.
ELEVENLABS_API_KEY=
# Optional. Default: George (JBFqnCBsd6RMkjVDRZzb), a warm British storyteller. Voices > copy Voice ID to change.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

PORT=8787
DATA_DIR=./data

# off | record | replay — replay serves recorded Context.dev responses without network
FIXTURE_MODE=off
